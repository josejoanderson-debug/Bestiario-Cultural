# Copie este arquivo para ".env" e preencha os valores antes de rodar
# `pnpm dev`. Nunca cometa o ".env" real no Git — ele já está no .gitignore.

# --- Banco de dados (Supabase Postgres) ---------------------------------
# Em Project Settings → Database → Connection string, use a "Connection
# pooling" (porta 6543, modo transaction/PgBouncer) para produção/Vercel.
# Para rodar `drizzle-kit` localmente (migrations), a conexão direta (porta
# 5432) também funciona.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# --- Sessão/administração local ------------------------------------------
# Gere um valor aleatório longo, ex.: `openssl rand -base64 48`
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
ADMIN_LOCAL_USERNAME=admin
ADMIN_LOCAL_PASSWORD=escolha-uma-senha-forte

# --- Cloudinary (armazenamento das imagens) ------------------------------
# Usado pelo painel administrativo para enviar fotos direto do navegador
# (unsigned upload) e, opcionalmente, pela rota legada de upload via servidor.
# Cloud name: painel do Cloudinary → topo da página (Dashboard).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Variáveis públicas (expostas ao navegador pelo Vite — não coloque segredos
# aqui). Criadas em Settings → Upload → Upload presets → Add upload preset,
# com "Signing Mode" = Unsigned.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

NODE_ENV=development
PORT=3000
